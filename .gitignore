cat > .gitignore <<'EOF'
# Virtual environments
.venv/
venv/

# Environment variables / secrets
.env
.env.*

# Keep the example environment file
!.env.example

# Local data
# Ignore local documents by default
data/*

# Include the synthetic sample corpus for the loader assignment
!data/sample_corpus/
!data/sample_corpus/**

# Python cache
__pycache__/
*.py[cod]

# macOS
.DS_Store
EOF